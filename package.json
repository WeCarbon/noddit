{
  "name": "@wecarbon/noddit",
  "version": "0.3.0",
  "description": "Noddit — where you and your AI hand work to each other: tasks and decisions as plain markdown files in your repo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wecarbon/noddit.git"
  },
  "homepage": "https://github.com/wecarbon/noddit",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nod": "./dist/bin/nod.js",
    "noddit": "./dist/bin/nod.js",
    "decs": "./dist/bin/decs.js",
    "decisions-md": "./dist/bin/decs.js"
  },
  "files": [
    "dist",
    "plugin",
    "skills",
    "hooks",
    "monitors",
    ".claude-plugin",
    "adapters",
    "README*",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 --import ./test/setup.ts \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "bidi-js": "^1.1.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.11",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.7.0"
  }
}
